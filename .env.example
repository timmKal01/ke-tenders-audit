# Copy to .env and fill in. Never commit .env.

# Any OpenAI-compatible endpoint serving an open-weights model.
# Local Ollama (default):
KTA_LLM_BASE_URL=http://localhost:11434/v1
KTA_LLM_API_KEY=ollama
KTA_LLM_MODEL=qwen3:4b

# Hosted Qwen on Groq (free key at console.groq.com):
# KTA_LLM_BASE_URL=https://api.groq.com/openai/v1
# KTA_LLM_API_KEY=your-groq-key
# KTA_LLM_MODEL=qwen/qwen3.8-27b

# Hosted Qwen through Hugging Face Inference Providers (token at huggingface.co/settings/tokens):
# KTA_LLM_BASE_URL=https://router.huggingface.co/v1
# KTA_LLM_API_KEY=your-hf-token
# KTA_LLM_MODEL=Qwen/Qwen3-32B

# Price per million tokens in USD, for the cost-per-run figure (0 for local).
KTA_COST_PER_MTOK_IN=0
KTA_COST_PER_MTOK_OUT=0
